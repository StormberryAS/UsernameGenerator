<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. `root` is the app's whole data directory, so excluding it
  covers the single preferences file and anything a future version adds without this file
  having to be revisited. cloud-backup is belt and braces on top of allowBackup="false";
  device-transfer is the one that matters, because that path is not governed by
  allowBackup at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
