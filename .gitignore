# Generated assets. Both are COPIES made at build time by the copyDictionaries
# Gradle task from data/ at the repo root, which is the source of truth. Committing
# them would give the repo two versions of the same word lists, free to disagree.
android/app/src/main/assets/data/

# Editor and OS noise
.idea/
.DS_Store
*.swp
