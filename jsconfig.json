{
  // Type-checking only. The browser still loads script.js as written: no build step, no emit.
  // index.html loads script.js as a single classic script (no import or export), so it is
  // checked as a script. It uses no third-party code, so types/ needs no declarations yet.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false
  },
  "include": ["script.js"]
}
